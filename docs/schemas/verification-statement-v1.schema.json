{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/IamAngusU/ContextBridge/blob/main/docs/schemas/verification-statement-v1.schema.json",
  "title": "ContextBridge Verification Statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "payload", "signature"],
  "properties": {
    "schema": { "const": "contextbridge.verification-statement.v1" },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program", "verification_id", "issuer", "subject", "tested_with", "scopes", "evidence", "issued_at", "expires_at"],
      "properties": {
        "program": { "const": "contextbridge-verified.v1" },
        "verification_id": { "$ref": "#/$defs/identifier" },
        "issuer": { "$ref": "#/$defs/text200" },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vendor", "product", "version", "artifact_sha256"],
          "properties": {
            "vendor": { "$ref": "#/$defs/text200" },
            "product": { "$ref": "#/$defs/text200" },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 },
            "artifact_sha256": { "$ref": "#/$defs/sha256" }
          }
        },
        "tested_with": {
          "type": "object",
          "additionalProperties": false,
          "required": ["contextbridge_version", "source_commit", "contracts"],
          "properties": {
            "contextbridge_version": { "type": "string", "minLength": 1, "maxLength": 100 },
            "source_commit": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
            "contracts": { "$ref": "#/$defs/identifiers" }
          }
        },
        "scopes": { "$ref": "#/$defs/identifiers" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "minLength": 88, "maxLength": 88 }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "identifiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "text200": { "type": "string", "minLength": 1, "maxLength": 200 }
  }
}
